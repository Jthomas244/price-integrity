# GhostCart probe secret — must equal PERSONA_PRICING_SECRET in GhostCart's
# Vercel production env. Get it with `vercel env pull` from the ghostcart repo.
GHOSTCART_PROBE_SECRET=
# Override only for local GhostCart runs (default: https://ghostcart-ten.vercel.app)
# GHOSTCART_BASE_URL=http://localhost:3000
